# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/

# Secrets / local env config
.env

# Local agent/workspace state
.agents/
.agent_runs/
.codex/
.claude/

# Local Kaggle/runtime artifacts
.kaggle_download/
kaggle_upload/kernel/run_output/

# Prediction/submission artifacts
input_turn*/
output_model*/
output_llm*/
output_turn*.zip
output.zip
source_bundle.zip

# Large model artifacts; keep these outside GitHub or share via release/LFS.
models/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.zip

# Raw RxNorm release dumps are huge. Commit only derived data/terminology/*.csv.
rrf/
prescribe/rrf/
prescribe/scripts/

# Same raw-in/derived-out rule for the BYT ICD-10 catalog: the ~10MB source CSV
# stays local, only data/terminology/icd10_vi.csv is committed.
data/terminology/raw/

# Upstream release readmes/dumps that are local-only.
/Readme_Full*.txt
prescribe/Readme_Full*.txt

# One-shot Kaggle upload bundle (train + terminology + BTC input)
kaggle_bundle/

# Experiment runs, packaged submissions, and archived past artifacts.
# experiments/<name>/ holds one prediction folder per configuration; the command
# that produced each one is recorded in docs/experiments.md, not in its name.
experiments/
submissions/
archive/

# Local safety copies written by recode_terminology.py. Git history is the real
# backup; committing these just creates a second, staler source of truth.
data/terminology/*.csv.bak

# Regenerated by `recode_terminology.py --audit` on demand; empty once applied.
data/terminology/recode_autofix.csv

# Upstream NLM/BYT release readmes live locally only (moved under docs/ during
# the 2026-08-01 cleanup, which stopped the old /Readme_Full*.txt rule matching).
docs/rxnorm_release_readme.txt
